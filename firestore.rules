rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Server-controlled custom claims ONLY (never trust client-writable document fields)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // 1. Student Profiles & Device Limits
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // CREATE: User can create their initial profile, but role cannot be set to 'admin'
      allow create: if (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
        (!('devices' in request.resource.data) || request.resource.data.devices.size() <= 3)
      ) || isAdmin();

      // UPDATE: Students can NEVER alter 'role', 'admin', 'permissions', or 'customClaims'
      allow update: if (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'permissions', 'customClaims'])) &&
        (!('devices' in request.resource.data) || request.resource.data.devices.size() <= 3)
      ) || isAdmin();
      
      allow delete: if isAdmin();

      // Mock Examination Sub-collection
      match /mockScores/{examId} {
        allow read: if isOwner(userId) || isAdmin();
        // Students can record a scored exam attempt only with valid score boundaries and a cryptographic server signature
        allow create: if isOwner(userId) &&
          request.resource.data.percentage >= 0 &&
          request.resource.data.percentage <= 100 &&
          request.resource.data.totalQuestions > 0 &&
          request.resource.data.score <= request.resource.data.totalQuestions &&
          ('signature' in request.resource.data && request.resource.data.signature is string && request.resource.data.signature.size() == 64);
        allow update, delete: if isAdmin();
      }
    }

    // 2. Curricula & Content CMS (Public Read, Admin Write)
    match /vocab/{vocabId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /kanji/{kanjiId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /grammar/{grammarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /translations/{langId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Security Audit Logs (Immutable, Admin Only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Only trusted admin sessions or server Admin SDK can generate security audit events
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
