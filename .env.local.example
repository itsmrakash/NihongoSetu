# ==============================================================================
# NIHONGOSETU — FIREBASE CLIENT & AI CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.local.example .env.local
# 2. In Firebase Console (https://console.firebase.google.com):
#    - Open your existing project -> Project Settings -> General -> Your apps -> Web app.
#    - Copy your web configuration keys into the placeholders below.
# 3. Never commit .env.local or your production API credentials to Git.
# ==============================================================================

# Firebase Web Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional

# Google Gemini API Key for AI Sensei (Optional)
# Obtain from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Secret salt for cryptographic exam verification (Server-side only)
EXAM_VERIFICATION_SECRET=your_secure_server_exam_salt_here

